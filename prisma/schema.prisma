generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductForm {
  RESIN
  CAPSULE
  POWDER
  GUMMY
  LIQUID
  BLEND
  OTHER
}

enum CoaStatus {
  PUBLIC
  REQUEST_ONLY
  NONE
  UNKNOWN
}

enum TransparencyGrade {
  F
  D
  C
  B
  A
}

enum QualityTier {
  POOR
  AVERAGE
  PREMIUM
  ULTRA_PREMIUM
}

enum OverallGrade {
  A_PLUS
  A
  B
  C
  D
  E
  F
}

enum EvidenceType {
  COA
  MANUFACTURING
  INGREDIENTS
  TESTING
  OTHER
}

enum DataCompleteness {
  LOW
  MEDIUM
  HIGH
}

enum IngestionRunType {
  DSLD
  BRAND_CRAWL
  DISCOVERY
  REFRESH
}

enum IngestionRunStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

enum CompanyRole {
  UNKNOWN
  MANUFACTURER
  DISTRIBUTOR
  MARKETER
  PACKAGER
  RESELLER
  OTHER
}

enum ListingSource {
  OFFICIAL
  AMAZON
  WALMART
  IHERB
  OTHER_RETAILER
  GOOGLE_SHOPPING
  MANUAL
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

enum MergeCandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  website     String?
  websiteDomain String?
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  aliases     BrandAlias[]
  companies   BrandCompany[]
}

model Product {
  id                        String                @id @default(cuid())
  brandId                   String
  brand                     Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name                      String
  slug                      String                @unique
  form                      ProductForm
  gtin                      String?               @unique
  mpn                       String?
  brandSku                  String?
  netQuantityText           String?
  servingsCount             Int?
  capsuleCount              Int?
  flavor                    String?
  ingredientText            String                @db.Text
  ingredientsNormalized     String[]              @default([]) @db.Text
  manufacturingCountryClaim String?
  manufacturingClaimText    String?               @db.Text
  manufacturingEvidenceUrl  String?
  coaStatus                 CoaStatus
  coaUrl                    String?
  thirdPartyTestingLab      String?               @db.Text
  hasPatentClaim            Boolean               @default(false)
  transparencyGrade         TransparencyGrade
  qualityTier               QualityTier
  overallGrade              OverallGrade?
  sourceDsldLabelId         String?               @unique
  sourceDsldUrl             String?
  dataCompleteness          DataCompleteness      @default(LOW)
  isCanonical               Boolean               @default(true)
  lastVerifiedAt            DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  officialCanonicalUrl      String?               @unique
  officialDomain            String?
  evidence                  Evidence[]
  listings                  Listing[]
  mergeCandidates           MergeCandidate[]      @relation("CandidateProduct")

  @@index([brandId])
  @@index([isCanonical])
  @@index([name])
  @@index([gtin])
  @@index([brandSku])
  @@index([officialDomain])
}

model Listing {
  id            String        @id @default(cuid())

  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  source        ListingSource

  url           String        @unique

  title         String?

  seller        String?

  priceCents    Int?

  currency      String?

  inStock       Boolean?

  shipsToUS     Boolean?

  observedGtin  String?

  observedSku   String?

  imageUrls     String[]      @default([]) @db.Text

  status        ListingStatus @default(UNKNOWN)

  lastSeenAt    DateTime?

  createdAt     DateTime      @default(now())

  updatedAt     DateTime      @updatedAt

  mergeCandidates MergeCandidate[]

  @@index([productId])

  @@index([source])

  @@index([observedGtin])
}

model MergeCandidate {
  id                 String               @id @default(cuid())
  listingId           String
  listing             Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  candidateProductId  String
  candidateProduct    Product              @relation("CandidateProduct", fields: [candidateProductId], references: [id], onDelete: Cascade)

  confidence          Float
  reasons             String[]             @default([]) @db.Text
  status              MergeCandidateStatus @default(PENDING)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([listingId])
  @@index([candidateProductId])
  @@index([status])
  @@unique([listingId, candidateProductId])
}

model Evidence {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      EvidenceType
  url       String
  sourceName String?
  quote     String?      @db.Text
  fetchedAt DateTime     @default(now())
  hash      String?
  createdAt DateTime     @default(now())

  @@index([productId])
}

model BrandAlias {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  alias     String
  source    String?
  createdAt DateTime @default(now())

  @@unique([brandId, alias])
  @@index([alias])
}

model CompanyEntity {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  website        String?
  websiteDomain  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  brands         BrandCompany[]
}

model BrandCompany {
  id            String       @id @default(cuid())
  brandId       String
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  companyId     String
  company       CompanyEntity @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role          CompanyRole   @default(UNKNOWN)
  sourceDsldId  String?
  createdAt     DateTime      @default(now())

  @@unique([brandId, companyId, role])
  @@index([companyId])
}

model IngestionRun {
  id        String             @id @default(cuid())
  type      IngestionRunType
  startedAt DateTime           @default(now())
  finishedAt DateTime?
  status    IngestionRunStatus @default(RUNNING)
  statsJson Json?
  errorText String?            @db.Text
  pid       Int?
}

enum JobType {
  ENRICH_OFFICIAL
  LINK_HEALTH
  DISCOVERY_ROBOTS_ALLOWED
  DISCOVER_OFFICIAL_FROM_DSLD_IMAGES
  DISCOVER_OFFICIAL_FROM_SITEMAPS
  URL_CSV_EXTRACT
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

model Job {
  id        String   @id @default(cuid())
  type      JobType  @unique
  name      String
  isEnabled Boolean  @default(true)
  schedule  String?  // cron string e.g. "0 3 * * *" (UTC), display only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      JobRun[]
}

model JobRun {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status     JobStatus @default(QUEUED)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  statsJson  Json?
  errorText  String?   @db.Text
  pid        Int?
  createdAt  DateTime  @default(now())

  @@index([jobId])
  @@index([status])
  @@index([startedAt])
}

