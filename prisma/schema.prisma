generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductForm {
  RESIN
  CAPSULE
  POWDER
  GUMMY
  LIQUID
  BLEND
  TABLETS
  HONEY_STICKS
  OTHER
}

enum CoaStatus {
  PUBLIC
  PUBLIC_EMBEDDED
  REQUEST_ONLY
  NONE
  UNKNOWN
}

/** What a product's COA actually reports for heavy metals. Replaces the legacy HeavyMetalsTested claim field for grading. */
enum HeavyMetalsResult {
  NUMERIC
  PASS_FAIL
  NONE
}

/** Whether a test covered the finished product or only the incoming ingredient/raw extract. */
enum TestScope {
  FINISHED_PRODUCT
  INGREDIENT
}

/** Who issued the COA. Manufacturer- and brand-issued documents score lower than an independent lab's. */
enum CoaIssuer {
  INDEPENDENT_LAB
  MANUFACTURER
  BRAND
}

/**
 * How easy the COA is to find from the product's own page. A certificate that exists but is
 * hidden behind a collapsed accordion is less transparent to a buyer than one linked in plain
 * sight, even though both are technically public.
 */
enum CoaDiscoverability {
  /** Linked from the product page in plain sight, with link text that says what it is. */
  PROMINENT
  /** Linked, but collapsed behind an accordion or labelled so vaguely it can't be scanned for. */
  BURIED
  /** The COA URL is public, but nothing on the product page links to it. */
  UNLINKED
  /** Not yet checked, or the product page could not be fetched. */
  UNKNOWN
}

enum HeavyMetalsTested {
  CONFIRMED
  CLAIMED
  NONE
}

enum TransparencyGrade {
  F
  D
  C
  B
  A
}

enum QualityTier {
  POOR
  AVERAGE
  PREMIUM
  ULTRA_PREMIUM
}

enum OverallGrade {
  A_PLUS
  A
  B
  C
  D
  E
  F
}

enum EvidenceType {
  COA
  MANUFACTURING
  INGREDIENTS
  TESTING
  OTHER
}

enum DataCompleteness {
  LOW
  MEDIUM
  HIGH
}

enum ListingSource {
  OFFICIAL
  AMAZON
  WALMART
  IHERB
  OTHER_RETAILER
  GOOGLE_SHOPPING
  MANUAL
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

model Brand {
  id            String    @id @default(cuid())
  name          String    @unique
  slug          String    @unique
  website       String?
  websiteDomain String?
  description   String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
}

model Product {
  id                        String            @id @default(cuid())
  brandId                   String
  brand                     Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name                      String
  slug                      String            @unique
  form                      ProductForm
  gtin                      String?           @unique
  mpn                       String?
  brandSku                  String?
  netQuantityText           String?
  servingsCount             Int?
  capsuleCount              Int?
  flavor                    String?
  ingredientText            String            @db.Text
  ingredientsNormalized     String[]          @default([]) @db.Text
  manufacturingCountryClaim String?
  manufacturingClaimText    String?           @db.Text
  manufacturingEvidenceUrl  String?
  coaStatus                 CoaStatus
  coaUrl                    String?
  coaNotes                  String?           @db.Text
  coaAnalysedAt             DateTime?
  thirdPartyTestingLab      String?           @db.Text
  hasPatentClaim            Boolean           @default(false)
  gmpCertified              Boolean           @default(false)
  sourceRegion              String?
  transparencyGrade         TransparencyGrade
  qualityTier               QualityTier
  overallGrade              OverallGrade?
  sourceDsldLabelId         String?           @unique
  sourceDsldUrl             String?
  dataCompleteness          DataCompleteness  @default(LOW)
  isCanonical               Boolean           @default(true)
  bestForTags               String[]          @default([])
  heavyMetalsTested         HeavyMetalsTested?
  // ── COA review fields (drive the overall grade; set from a reviewed COA document) ──
  /** True when a real lab document for this product has been reviewed and verified. */
  coaVerified               Boolean           @default(false)
  coaIssuer                 CoaIssuer?
  /** Date on the COA itself (not the review date — that's coaAnalysedAt). */
  coaReportDate             DateTime?
  /** True when the COA itself names the testing laboratory. */
  labNamedOnCoa             Boolean           @default(false)
  /** True when the COA carries a batch or lot code tying it to the product sold. */
  coaBatchIdentified        Boolean           @default(false)
  heavyMetalsResult         HeavyMetalsResult?
  heavyMetalsScope          TestScope?
  /** True when the COA includes a microbial panel. */
  microbialPanel            Boolean           @default(false)
  /** How findable the COA is from the product page. Set by scripts/audit-coa-discoverability.ts. */
  coaDiscoverability        CoaDiscoverability @default(UNKNOWN)
  pricePerServingCents      Int?
  pricePerGramCents         Int?
  lastVerifiedAt            DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  officialCanonicalUrl      String?           @unique
  officialDomain            String?
  metaDescription           String?           @db.VarChar(160)
  evidence                  Evidence[]
  listings                  Listing[]

  @@index([brandId])
  @@index([isCanonical])
  @@index([name])
  @@index([gtin])
  @@index([brandSku])
  @@index([officialDomain])
}

model Listing {
  id           String        @id @default(cuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  source       ListingSource
  url          String        @unique
  isAffiliate  Boolean       @default(false)
  title        String?
  seller       String?
  priceCents   Int?
  currency     String?
  inStock      Boolean?
  shipsToUS    Boolean?
  observedGtin String?
  observedSku  String?
  imageUrls    String[]      @default([]) @db.Text
  status       ListingStatus @default(UNKNOWN)
  lastSeenAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([productId])
  @@index([source])
  @@index([observedGtin])
}

model Evidence {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       EvidenceType
  url        String
  sourceName String?
  quote      String?      @db.Text
  fetchedAt  DateTime     @default(now())
  hash       String?
  createdAt  DateTime     @default(now())

  @@index([productId])
}
