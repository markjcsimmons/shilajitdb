generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductForm {
  RESIN
  CAPSULE
  POWDER
  GUMMY
  LIQUID
  BLEND
  TABLETS
  HONEY_STICKS
  OTHER
}

enum CoaStatus {
  PUBLIC
  PUBLIC_EMBEDDED
  REQUEST_ONLY
  NONE
  UNKNOWN
}

enum TransparencyGrade {
  F
  D
  C
  B
  A
}

enum QualityTier {
  POOR
  AVERAGE
  PREMIUM
  ULTRA_PREMIUM
}

enum OverallGrade {
  A_PLUS
  A
  B
  C
  D
  E
  F
}

enum EvidenceType {
  COA
  MANUFACTURING
  INGREDIENTS
  TESTING
  OTHER
}

enum DataCompleteness {
  LOW
  MEDIUM
  HIGH
}

enum ListingSource {
  OFFICIAL
  AMAZON
  WALMART
  IHERB
  OTHER_RETAILER
  GOOGLE_SHOPPING
  MANUAL
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

model Brand {
  id            String    @id @default(cuid())
  name          String    @unique
  slug          String    @unique
  website       String?
  websiteDomain String?
  description   String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
}

model Product {
  id                        String            @id @default(cuid())
  brandId                   String
  brand                     Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name                      String
  slug                      String            @unique
  form                      ProductForm
  gtin                      String?           @unique
  mpn                       String?
  brandSku                  String?
  netQuantityText           String?
  servingsCount             Int?
  capsuleCount              Int?
  flavor                    String?
  ingredientText            String            @db.Text
  ingredientsNormalized     String[]          @default([]) @db.Text
  manufacturingCountryClaim String?
  manufacturingClaimText    String?           @db.Text
  manufacturingEvidenceUrl  String?
  coaStatus                 CoaStatus
  coaUrl                    String?
  thirdPartyTestingLab      String?           @db.Text
  hasPatentClaim            Boolean           @default(false)
  gmpCertified              Boolean           @default(false)
  sourceRegion              String?
  transparencyGrade         TransparencyGrade
  qualityTier               QualityTier
  overallGrade              OverallGrade?
  sourceDsldLabelId         String?           @unique
  sourceDsldUrl             String?
  dataCompleteness          DataCompleteness  @default(LOW)
  isCanonical               Boolean           @default(true)
  pricePerServingCents      Int?
  lastVerifiedAt            DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  officialCanonicalUrl      String?           @unique
  officialDomain            String?
  metaDescription           String?           @db.VarChar(160)
  evidence                  Evidence[]
  listings                  Listing[]

  @@index([brandId])
  @@index([isCanonical])
  @@index([name])
  @@index([gtin])
  @@index([brandSku])
  @@index([officialDomain])
}

model Listing {
  id           String        @id @default(cuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  source       ListingSource
  url          String        @unique
  title        String?
  seller       String?
  priceCents   Int?
  currency     String?
  inStock      Boolean?
  shipsToUS    Boolean?
  observedGtin String?
  observedSku  String?
  imageUrls    String[]      @default([]) @db.Text
  status       ListingStatus @default(UNKNOWN)
  lastSeenAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([productId])
  @@index([source])
  @@index([observedGtin])
}

model Evidence {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       EvidenceType
  url        String
  sourceName String?
  quote      String?      @db.Text
  fetchedAt  DateTime     @default(now())
  hash       String?
  createdAt  DateTime     @default(now())

  @@index([productId])
}
