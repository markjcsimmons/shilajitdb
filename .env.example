# Local Postgres example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shilajit_transparency?schema=public"
# Supabase: use Connection pooler (Session, port 5432) from Dashboard → Connect. Pooler format:
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# If you see "other side closed" / UND_ERR_SOCKET during pipeline runs, add:
# ?connection_limit=5&pool_timeout=30
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shilajit_transparency?schema=public"
ADMIN_PASSWORD="change-me"
# Set true to disable /admin login gate (admin becomes public).
# ADMIN_DISABLE_AUTH="true"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_REPORT_EMAIL="updates@example.com"
DSLD_API_BASE_URL="https://dsld-dev-api.app.cloud.gov/api/v9"
# Prisma query throttling (helps avoid Supabase connection exhaustion during ingestion/dev).
# PRISMA_QUERY_CONCURRENCY="2"
# PRISMA_QUERY_RETRY_ATTEMPTS="3"
# Optional: increase timeout for slow DSLD responses
# DSLD_API_TIMEOUT_MS="60000"
# Optional (higher rate limit):
# DSLD_API_KEY="your-data-gov-api-key"
# Optional (for discovery run):
# DISCOVERY_CSV_PATH="/absolute/path/to/discovery.csv"
# Optional: Upstash Redis for distributed rate limiting across serverless instances.
# Get credentials from upstash.com → Create Database → REST API
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

