{
  "name": "shilajit-transparency-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev",
    "predev": "tsx scripts/checkPrisma.ts",
    "prebuild": "tsx scripts/checkPrisma.ts",
    "postinstall": "prisma generate",
    "reset:prisma-next": "rm -rf .next node_modules/.prisma && npx prisma generate",
    "dev:clean": "pkill -f \"next dev\" || true && rm -rf .next && next dev",
    "build": "next build",
    "prisma:reset-client": "node -e \"require('fs').rmSync('node_modules/.prisma', {recursive:true, force:true})\" && npx prisma generate",
    "start": "next start",
    "lint": "next lint",
    "prisma": "prisma",
    "db:migrate": "prisma migrate dev",
    "db:push": "node -r dotenv/config ./node_modules/.bin/prisma db push",
    "db:push:no-config": "bash scripts/db-push-no-config.sh",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:clear": "tsx scripts/clearDatabase.ts",
    "db:recompute": "tsx scripts/recompute-grades.ts",
    "db:recompute-overall-grades": "tsx scripts/recompute-overall-grades.ts",
    "cleanup:brands:noproducts": "tsx scripts/cleanup/removeBrandsWithNoProducts.ts",
    "sanity-check:search": "tsx scripts/sanity-check-search.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "next": "^15.5.0",
    "p-limit": "^7.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.20.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.1",
    "prisma": "^6.16.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
