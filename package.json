  "dependencies": {
    "@prisma/client": "^6.16.1",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "next": "^15.5.0",
    "p-limit": "^7.3.0",
