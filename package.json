{
  "name": "shilajit-transparency-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev",
    "predev": "tsx scripts/checkPrisma.ts",
