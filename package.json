    "discover:dsld-images": "tsx scripts/ingest/discovery/dsld_images/discoverOfficialFromDsldImages.ts",
    "discover:sitemaps": "tsx scripts/ingest/discovery/sitemaps/harvestOfficialProductUrlsFromSitemaps.ts",
    "job": "tsx scripts/jobs/runJob.ts",
    "sanity-check:search": "tsx scripts/sanity-check-search.ts",
    "salvage:collapse": "tsx scripts/admin/salvageCollapseUnknownPlaceholders.ts",
    "cleanup:junk": "tsx scripts/sql/runCleanup.ts",
    "ingest:url-csv": "tsx scripts/ingest/url_csv/runUrlCsvExtract.ts"
