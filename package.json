    "build": "next build",
    "prisma:reset-client": "node -e \"require('fs').rmSync('node_modules/.prisma', {recursive:true, force:true})\" && npx prisma generate",
    "start": "next start",
    "lint": "next lint",
    "prisma": "prisma",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:recompute": "tsx scripts/recompute-grades.ts",
    "cleanup:dsld:nonshilajit": "tsx scripts/cleanup/removeNonShilajitDsld.ts",
    "cleanup:brands:noproducts": "tsx scripts/cleanup/removeBrandsWithNoProducts.ts",
    "ingest:dsld:shilajit": "tsx scripts/ingest/dsld/ingestShilajitFromDsld.ts",
    "ingest:web:brands": "tsx scripts/ingest/web/crawlBrandSites.ts",
    "ingest:discovery:csv": "tsx scripts/ingest/discovery/importBrandWebsiteCsv.ts",
    "ingest:discovery:run": "tsx scripts/ingest/discovery/runDiscovery.ts",
    "ingest:discovery:websites": "tsx scripts/ingest/discovery/discoverBrandWebsitesFromDsld.ts",
    "ingest:listings": "tsx scripts/ingest/discovery/importCsv.ts",
